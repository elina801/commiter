# Target local clone. Relative paths are resolved from this .env file's directory.
COMMITER_REPO=/path/to/your/repo
# GitHub target; leave blank to infer it from the clone's origin remote.
COMMITER_GITHUB=owner/repository

# Message 1, 2, and 3 belong to account 1, 2, and 3 respectively.
GITHUB_ACCOUNT_1=
GITHUB_TOKEN_1=
GITHUB_ACCOUNT_2=
GITHUB_TOKEN_2=
GITHUB_ACCOUNT_3=
GITHUB_TOKEN_3=

# Relative commit counts, with up to 15% variation by default.
COMMITER_WEIGHTS=40,30,30
COMMITER_JITTER=0.15
# Blank = automatically choose the number of commits from the change size.
COMMITER_COMMITS=
COMMITER_LINES_PER_COMMIT=200
# Blank = a fresh random distribution; set an integer to repeat an allocation.
COMMITER_SEED=

# worktree includes staged + unstaged changes; staged uses only the index.
COMMITER_SOURCE=worktree
# files keeps whole files together; hunks splits separate edits in existing files.
COMMITER_SPLIT=files
COMMITER_PUSH=true
# true previews only; false creates commits and pushes when COMMITER_PUSH=true.
COMMITER_DRY_RUN=false
# Blank = ~/.local/state/commiter (or the XDG state directory).
COMMITER_STATE_DIR=

# Optional author names and verified commit emails; blank uses GitHub profile/noreply.
GITHUB_NAME_1=
GITHUB_EMAIL_1=
GITHUB_NAME_2=
GITHUB_EMAIL_2=
GITHUB_NAME_3=
GITHUB_EMAIL_3=
